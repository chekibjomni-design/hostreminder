# ──────────────────────────────────────────────
# HostReminder — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ──────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ── Base de données PostgreSQL (Supabase) ──
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public

# ── Sécurité & Sessions ──
SESSION_SECRET=changez-moi-par-une-chaîne-aléatoire-sécurisée-dau-moins-32-caractères

# ── IA Réponse Automatique (Groq) ──
GROQ_API_KEY=gsk_votre_cle_groq

# ── Suivi de Vol (AeroDataBox via RapidAPI) ──
FLIGHT_API_KEY=votre_cle_rapidapi_aerodatabox

# ── WhatsApp Meta Cloud API ──
META_WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=votre_meta_access_token

# ── SMTP Transactionnel (Brevo / SendinBlue) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre_email_brevo
SMTP_PASS=votre_cle_smtp_brevo

# ── OAuth Providers ──
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optionnel : URL de rappel personnalisée
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# FACEBOOK_CALLBACK_URL=https://yourdomain.com/api/auth/facebook/callback

# Airbnb OAuth (utilise le flux OAuth2 générique)
AIRBNB_CLIENT_ID=your_airbnb_client_id
AIRBNB_CLIENT_SECRET=your_airbnb_client_secret
# AIRBNB_CALLBACK_URL=https://yourdomain.com/api/auth/airbnb/callback